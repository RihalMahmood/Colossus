<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".HomeActivity">

    <!-- Purple Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/colossus_purple"
        android:elevation="4dp"
        app:title="Colossus"
        app:titleTextColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Horizontal Header: Logo + Welcome Text -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="90dp"
            android:layout_height="80dp"
            android:contentDescription="@string/colossus_logo_desc"
            android:src="@drawable/logo"
            android:layout_marginEnd="20dp" />

        <TextView
            android:id="@+id/welcome_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_message"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:maxWidth="220dp" />

    </LinearLayout>

    <!-- View Files Button -->
    <Button
        android:id="@+id/btn_view_files"
        android:layout_width="262dp"
        android:layout_height="65dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/rounded_button"
        app:backgroundTint="@null"
        android:text="@string/view_files"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Check Storage Button -->
    <Button
        android:id="@+id/btn_check_storage"
        android:layout_width="262dp"
        android:layout_height="65dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded_button"
        app:backgroundTint="@null"
        android:text="@string/checkStorage"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btn_view_files"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Add Drive Button -->
    <Button
        android:id="@+id/btn_add_bucket"
        android:layout_width="262dp"
        android:layout_height="65dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded_button"
        app:backgroundTint="@null"
        android:text="@string/add_bucket"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btn_check_storage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Upload Files Button -->
    <Button
        android:id="@+id/btn_upload_files"
        android:layout_width="262dp"
        android:layout_height="65dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/rounded_button"
        app:backgroundTint="@null"
        android:text="@string/upload"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btn_add_bucket"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Exit Button -->
    <Button
        android:id="@+id/btn_exit"
        android:layout_width="262dp"
        android:layout_height="65dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/rounded_button"
        app:backgroundTint="@null"
        android:text="@string/exit"
        android:textAllCaps="true"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/btn_upload_files"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
